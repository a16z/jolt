#!/usr/bin/python3
"""Credential-free forced SSH command for the dedicated benchmark account."""

import fcntl
import json
import os
from pathlib import Path, PurePosixPath
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import zipfile

JOB_ID = r'[a-z0-9][a-z0-9-]{0,63}'
LIMITS = {'dispatch.json': 1024 * 1024, 'plan.zip': 8 * 1024 * 1024,
          'builds.zip': 32 * 1024**3}
TIMEOUTS = {'pr': 120 * 60, 'main': 180 * 60, 'nightly': 180 * 60}


def write_json(filename, value):
    temporary = filename.with_suffix('.tmp')
    temporary.write_text(json.dumps(value) + '\n')
    temporary.replace(filename)


def environment(home, temporary):
    return {'HOME': str(home), 'USER': pwd.getpwuid(os.getuid()).pw_name,
            'LOGNAME': pwd.getpwuid(os.getuid()).pw_name,
            'PATH': f'{home}/.cargo/bin:{home}/.local/bin:/usr/local/bin:/usr/bin:/bin',
            'CARGO_HOME': str(home / '.cargo'), 'RUSTUP_HOME': str(home / '.rustup'),
            'TMPDIR': str(temporary), 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8',
            'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': '/dev/null',
            'GIT_TERMINAL_PROMPT': '0'}


def process_identity(pid):
    try:
        fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
        if fields[0] == 'Z':
            return None
        return {'pid': pid, 'start': fields[19],
                'boot': Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
    except (OSError, IndexError):
        return None


def status(job):
    if not job.exists():
        return {'state': 'absent', 'exit_code': None}
    if (job / 'exit.json').exists():
        return {'state': 'finished', 'exit_code': json.loads((job / 'exit.json').read_text())['exit_code']}
    try:
        worker = json.loads((job / 'worker.json').read_text())
        alive = process_identity(worker['pid']) == worker
    except FileNotFoundError:
        alive = False
    return {'state': 'running' if alive else 'lost', 'exit_code': None}


def extract_zip(filename, destination, *, plan=False):
    with zipfile.ZipFile(filename) as archive:
        members = archive.infolist()
        names = set()
        total = 0
        for member in members:
            name = PurePosixPath(member.filename)
            mode = member.external_attr >> 16
            if (name.is_absolute() or '..' in name.parts or '\\' in member.filename
                    or not name.parts or name.as_posix() != member.filename.rstrip('/') or member.filename in names
                    or stat.S_ISLNK(mode) or (stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR))):
                raise ValueError('unsafe or duplicate ZIP member')
            names.add(member.filename)
            total += member.file_size
            if total > (8 * 1024**2 if plan else 64 * 1024**3) or len(names) > 100000:
                raise ValueError('ZIP exceeds extraction limit')
        if plan and names != {'plan.json'}:
            raise ValueError('plan ZIP must contain exactly plan.json')
        archive.extractall(destination)


def fetch_harness(job, plan, env):
    source = job / 'harness'
    subprocess.run(['git', 'init', '-q', str(source)], env=env, check=True, timeout=30,
                   stdout=subprocess.DEVNULL)
    subprocess.run(['git', '-C', str(source), 'remote', 'add', 'origin',
                    'https://github.com/a16z/jolt.git'], env=env, check=True, timeout=30,
                   stdout=subprocess.DEVNULL)
    subprocess.run(['git', '-C', str(source), 'fetch', '--depth=1', '--no-tags', 'origin',
                    plan['harness']], env=env, check=True, timeout=300, stdout=subprocess.DEVNULL)
    subprocess.run(['git', '-C', str(source), '-c', 'core.hooksPath=/dev/null',
                    'checkout', '--detach', plan['harness']], env=env, check=True, timeout=60,
                   stdout=subprocess.DEVNULL)


def submit(job, stream, home, lock_fd=None):
    if job.exists():
        return {'state': 'exists'}
    job.mkdir(mode=0o700)
    try:
        names = set()
        with tarfile.open(fileobj=stream, mode='r|') as archive:
            for member in archive:
                if (member.name not in LIMITS or member.name in names or not member.isfile()
                        or member.size < 0 or member.size > LIMITS[member.name]):
                    raise ValueError('unexpected, duplicate, or oversized tar member')
                names.add(member.name)
                with archive.extractfile(member) as source, (job / member.name).open('xb') as target:
                    shutil.copyfileobj(source, target, length=1024 * 1024)
        manifest = json.loads((job / 'dispatch.json').read_text())
        run_id, attempt = manifest['run_id'], manifest['run_attempt']
        if (manifest['schema'] != 1 or type(run_id) is not int or run_id <= 0
                or type(attempt) is not int or attempt <= 0 or job.name != f'{run_id}-{attempt}'
                or manifest['tier'] not in TIMEOUTS
                or manifest['plan_artifact'] != f'jolt-e2e-plan-{run_id}-{attempt}'):
            raise ValueError('dispatch identity does not match the job')
        builds = manifest['builds_artifact']
        if builds != (None if manifest['tier'] == 'pr' else f'jolt-e2e-builds-{run_id}-{attempt}'):
            raise ValueError('unexpected builds artifact')
        if names != {'dispatch.json', 'plan.zip'} | ({'builds.zip'} if builds else set()):
            raise ValueError('tar file set does not match dispatch')
        extract_zip(job / 'plan.zip', job, plan=True)
        plan = json.loads((job / 'plan.json').read_text())
        if (plan['enabled'] is not True or plan['tier'] != manifest['tier']
                or not re.fullmatch('[0-9a-f]{40}', plan['harness'])
                or str(plan['provenance']['run_id']) != str(run_id)
                or str(plan['provenance']['run_attempt']) != str(attempt)):
            raise ValueError('plan does not match dispatch')
        if builds:
            extract_zip(job / 'builds.zip', job / 'bundles')
        (job / 'tmp').mkdir()
        env = environment(home, job / 'tmp')
        fetch_harness(job, plan, env)
        with (job / 'worker.log').open('ab') as log:
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--worker', str(job),
                              str(lock_fd if lock_fd is not None else -1)],
                stdin=subprocess.DEVNULL, stdout=log, stderr=log, cwd=job,
                env=env, start_new_session=True, close_fds=True,
                pass_fds=() if lock_fd is None else (lock_fd,))
        return {'state': 'submitted'}
    except BaseException:
        shutil.rmtree(job)
        raise


def worker(job, home, lock_fd=-1):
    code = 1
    try:
        try:
            write_json(job / 'worker.json', process_identity(os.getpid()))
        finally:
            # Keep status/remove behind submit's lock until the detached worker
            # publishes its identity, even if the submitting SSH process exits.
            if lock_fd >= 0:
                os.close(lock_fd)
        plan = json.loads((job / 'plan.json').read_text())
        env = environment(home, job / 'tmp')
        source = job / 'harness'
        command = [sys.executable, str(source / 'scripts/bench/ci.py')]
        common = ['--plan', str(job / 'plan.json'), '--out', str(job / 'result')]
        try:
            with subprocess.Popen(command + ['target', '--dispatch', str(job / 'dispatch.json'),
                    '--bundles', str(job / 'bundles'), *common], cwd=source, env=env,
                    start_new_session=True) as child:
                try:
                    code = child.wait(timeout=TIMEOUTS[plan['tier']])
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGTERM)
                    try:
                        child.wait(timeout=30)
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait()
                    code = 124
        finally:
            final = subprocess.run(command + ['finalize', '--dispatch', str(job / 'dispatch.json'), *common],
                                   cwd=source, env=env, timeout=60)
            if final.returncode and code == 0:
                code = final.returncode
    except BaseException as error:
        code = code or 1
        print(f'executor: {error}', file=sys.stderr, flush=True)
    finally:
        write_json(job / 'exit.json', {'exit_code': code})


def fetch(job, output):
    if status(job)['state'] != 'finished':
        raise ValueError('only a finished job can be fetched')
    root = job / 'result'
    if not (root / 'benchmark-results.json').is_file():
        raise ValueError('job has no root result')
    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED, allowZip64=True) as archive:
        for filename in sorted(root.rglob('*')):
            relative = filename.relative_to(root)
            if relative.parts[0] == 'builds' or 'runtime-cache' in relative.parts:
                continue
            if filename.is_symlink():
                raise ValueError('result contains a symlink')
            if filename.is_file():
                archive.write(filename, relative.as_posix())


def main():
    home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    if len(sys.argv) == 4 and sys.argv[1] == '--worker':
        worker(Path(sys.argv[2]), home, int(sys.argv[3]))
        return
    if len(sys.argv) != 1:
        raise ValueError('only SSH_ORIGINAL_COMMAND is accepted')
    match = re.fullmatch(rf'(submit|status|fetch|remove) ({JOB_ID})', os.environ.get('SSH_ORIGINAL_COMMAND', ''))
    if match is None:
        raise ValueError('expected one executor verb and job id')
    verb, job_id = match.groups()
    root = home / '.local/share/jolt-bench/jobs'
    os.umask(0o077)
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (root / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        job = root / job_id
        if verb == 'fetch':
            fetch(job, sys.stdout.buffer)
            return
        if verb == 'submit':
            result = submit(job, sys.stdin.buffer, home, lock.fileno())
        elif verb == 'status':
            result = status(job)
        else:
            if job.exists():
                shutil.rmtree(job)
            result = {'state': 'removed'}
        print(json.dumps(result))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, tarfile.TarError, zipfile.BadZipFile) as error:
        print(f'executor: {error}', file=sys.stderr)
        raise SystemExit(1)
