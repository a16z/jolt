+#[test]
+fn gt_conjugation_is_not_inverse_without_a_target_subgroup_check() {
+    let mut rng = ChaCha20Rng::seed_from_u64(0x000B_AD67);
+    let value = Fq12::rand(&mut rng);
+    let mut coordinates = fq12_coords(&value);
+    for (index, coordinate) in coordinates.iter_mut().enumerate() {
+        if conjugated(index) {
+            *coordinate = -*coordinate;
+        }
+    }
+    assert_ne!(
+        fq12_from_coords(&coordinates),
+        ArkField::inverse(&value).unwrap()
+    );
+}
