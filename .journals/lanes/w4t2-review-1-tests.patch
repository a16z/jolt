+#[test]
+fn out_of_range_chunk_is_accepted_with_multiplicity_above_the_range_table() {
+    let w = witness(0xE2E);
+    let mut rng = ChaCha20Rng::seed_from_u64(11);
+    let relation = RowRelation::new(
+        challenges(&mut rng),
+        LookupConstants {
+            one_row: w.layout.one_cell * 16,
+        },
+    );
+    let public = PublicColumns::new(&w.layout);
+    let mut columns = matrix(&w, &relation, &public, &public.digits.clone());
+
+    let data_row = w.layout.program.input_rows[0] as usize;
+    let chunk = Z_CHUNKS;
+    let invalid = 1usize << 16;
+    assert_eq!(columns[Col::CHUNKS + chunk][data_row], Fr::zero());
+    columns[Col::CHUNKS + chunk][data_row] = Fr::from_u64(invalid as u64);
+
+    let group = chunk / GROUP_SIZE;
+    let denominator = (0..GROUP_SIZE).fold(Fr::from_u64(1), |acc, i| {
+        acc * (relation.challenges.alpha - columns[Col::CHUNKS + group * GROUP_SIZE + i][data_row])
+    });
+    columns[Col::HELPERS + group][data_row] = denominator.inverse().unwrap();
+    columns[Col::MULT][0] -= Fr::from_u64(1);
+    columns[Col::MULT][invalid] += Fr::from_u64(1);
+    columns[Col::INV][invalid] = (relation.challenges.alpha - Fr::from_u64(invalid as u64))
+        .inverse()
+        .unwrap();
+
+    accepts(columns, &relation, &w.layout);
+}
