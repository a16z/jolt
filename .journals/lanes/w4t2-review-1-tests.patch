+#[test]
+fn affine_addition_accepts_an_arbitrary_slope_when_points_are_equal() {
+    let point = G1Affine::generator();
+    let template = g1_add(false);
+    let mut own = [Fq::zero(); 4];
+    let coordinate =
+        |reference: jolt_wrapper::limb_table::template::Ref, own: &[Fq; 4]| match reference.elem {
+            0 => own[reference.coord as usize],
+            1 | 2 => {
+                if reference.coord == 0 {
+                    point.x
+                } else {
+                    point.y
+                }
+            }
+            3 => Fq::from(1u64),
+            _ => unreachable!(),
+        };
+    let evaluate = |row: usize, own: &[Fq; 4]| {
+        template.rows[row]
+            .slots
+            .iter()
+            .fold(Fq::zero(), |acc, (x, y, coefficient)| {
+                acc + coordinate(*x, own) * coordinate(*y, own) * signed(*coefficient)
+            })
+    };
+
+    own[0] = Fq::zero();
+    assert_eq!(evaluate(1, &own), Fq::zero(), "slope pin is vacuous");
+    own[2] = evaluate(2, &own);
+    own[3] = evaluate(3, &own);
+    let doubled = point.into_group().double().into_affine();
+    assert_ne!((own[2], own[3]), (doubled.x, doubled.y));
+}
