+#[test]
+fn selected_operand_collision_is_accepted_when_fingerprint_root_is_known() {
+    let w = witness(0xE2E);
+    let mut rng = ChaCha20Rng::seed_from_u64(11);
+    let relation = RowRelation::new(
+        challenges(&mut rng),
+        LookupConstants {
+            one_row: w.layout.one_cell * 16,
+        },
+    );
+    let public = PublicColumns::new(&w.layout);
+    let mut columns = matrix(&w, &relation, &public, &public.digits.clone());
+
+    let mut attack = None;
+    for op in w
+        .layout
+        .digit_ops
+        .iter()
+        .filter(|op| op.kind == ReadKind::Gt)
+    {
+        let row = op.first_row as usize;
+        for a in 0..SLOTS - 2 {
+            for b in a + 1..SLOTS - 1 {
+                for c in b + 1..SLOTS {
+                    let f = [
+                        relation.fingerprint_weight(a),
+                        relation.fingerprint_weight(b),
+                        relation.fingerprint_weight(c),
+                    ];
+                    let x = [
+                        columns[Col::X + a][row],
+                        columns[Col::X + b][row],
+                        columns[Col::X + c][row],
+                    ];
+                    let delta = [
+                        f[1] * x[2] - f[2] * x[1],
+                        f[2] * x[0] - f[0] * x[2],
+                        f[0] * x[1] - f[1] * x[0],
+                    ];
+                    if delta.iter().any(|value| !value.is_zero()) {
+                        attack = Some((row, [a, b, c], delta));
+                        break;
+                    }
+                }
+                if attack.is_some() {
+                    break;
+                }
+            }
+            if attack.is_some() {
+                break;
+            }
+        }
+        if attack.is_some() {
+            break;
+        }
+    }
+    let (row, slots, delta) = attack.expect("non-degenerate selected GT row");
+    for (slot, change) in slots.into_iter().zip(delta) {
+        columns[Col::Y + slot][row] += change;
+    }
+
+    accepts(columns, &relation, &w.layout);
+}
