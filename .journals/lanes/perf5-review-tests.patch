+    /// Independent oracle for the review: promote every packed entry to a field
+    /// element and take the plain weighted sum over a prefix.
+    pub(crate) fn review_naive_rlc_prefix(&self, weights: &[Fr], len: usize) -> Vec<Fr> {
+        let mut combined = vec![Fr::zero(); len];
+        for (polynomial, &weight) in self.polynomials.iter().zip(weights) {
+            for (index, target) in combined.iter_mut().enumerate() {
+                let entry = match polynomial {
+                    PackedPolynomial::Bits(values) => Fr::from_u64(u64::from(values[index])),
+                    PackedPolynomial::U16(values) => Fr::from_u64(u64::from(values[index])),
+                    PackedPolynomial::U32(values) => Fr::from_u64(u64::from(values[index])),
+                    PackedPolynomial::Fr(values) => values[index],
+                };
+                *target += entry * weight;
+            }
+        }
+        combined
+    }
