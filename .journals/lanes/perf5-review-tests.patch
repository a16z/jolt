+    /// Every attack here commits before `r` is drawn and then produces a
+    /// *genuinely valid* five-point batch opening of exactly what it committed:
+    /// all polynomials are zero-padded to one length, so `kzg_open_batch` folds
+    /// the full oversized fold into `B` and the pairing check passes on its own
+    /// terms. Only the protocol-level fold binding rejects them.
+    #[test]
+    fn review_unbounded_and_predicted_point_folds_reject() {
+        const PADDED: usize = 128;
+        let (pk, vk) = test_setup(PADDED);
+        let mut rng = ChaCha20Rng::seed_from_u64(0x5ef5);
+        for num_vars in [5, 6] {
+            let poly = Polynomial::<Fr>::random(num_vars, &mut rng);
+            let point: Vec<_> = (0..num_vars).map(|_| Fr::random(&mut rng)).collect();
+            let claim = poly.evaluate(&point);
+            let honest = TestScheme::fold_polynomials(poly.evaluations(), &point);
+            let last_level = honest.len() - 1;
+            // A prover that guesses `r` before committing.
+            let mut predicted = Blake2bTranscript::new(b"review-folds");
+            for polynomial in honest.iter().skip(1) {
+                predicted.append(&kzg::kzg_commit::<Bn254>(polynomial, &pk).unwrap());
+            }
+            let guess: Fr = predicted.challenge();
+            for attack in 0..4 {
+                let mut polynomials = honest.clone();
+                for polynomial in &mut polynomials {
+                    polynomial.resize(PADDED, Fr::from_u64(0));
+                }
+                match attack {
+                    // Middle fold above every honest degree: caught only by the
+                    // r^4 chain, never by a per-level degree bound.
+                    0 => polynomials[1][PADDED - 1] = Fr::one(),
+                    // Terminal fold above its two/four honest coefficients.
+                    1 => polynomials[last_level][PADDED - 1] = Fr::one(),
+                    // Add the batch divisor (X^4 - guess^4)(X - guess^4): the
+                    // fold agrees with the honest one at all five points of the
+                    // *guessed* challenge.
+                    2 => {
+                        let s = guess.square().square();
+                        polynomials[1][0] += s.square();
+                        polynomials[1][1] -= s;
+                        polynomials[1][4] -= s;
+                        polynomials[1][5] += Fr::one();
+                        for u in [guess, -guess, s] {
+                            assert_eq!(
+                                kzg::eval_univariate(&polynomials[1], u),
+                                kzg::eval_univariate(&honest[1], u),
+                            );
+                        }
+                    }
+                    // Residue order swap inside one fold.
+                    _ => polynomials[1].swap(0, 1),
+                }
+                let commitments = polynomials
+                    .iter()
+                    .map(|p| kzg::kzg_commit::<Bn254>(p, &pk).unwrap())
+                    .collect::<Vec<_>>();
+                assert_eq!(
+                    commitments[0],
+                    kzg::kzg_commit::<Bn254>(poly.evaluations(), &pk).unwrap(),
+                    "padding must not move the committed polynomial",
+                );
+                let com = commitments[1..].to_vec();
+                let mut transcript = Blake2bTranscript::new(b"review-folds");
+                let mut batch = Blake2bTranscript::new(b"review-folds");
+                for commitment in &com {
+                    transcript.append(commitment);
+                    batch.append(commitment);
+                }
+                let r: Fr = transcript.challenge();
+                assert_eq!(r, batch.challenge());
+                assert_ne!(r, guess, "committing the tampered fold moves r");
+                let points = FoldPoints::new(r, &mut NoopVerifierObserver).unwrap();
+                let (w, v, p0_at_r_fourth) =
+                    kzg_open_batch::<Bn254, _>(&polynomials, &points, &pk, &mut transcript).unwrap();
+                let truthful_fifth_row = polynomials
+                    .iter()
+                    .map(|p| kzg::eval_univariate(p, r.square().square()))
+                    .collect();
+                let full = [
+                    v[0].clone(),
+                    v[1].clone(),
+                    v[2].clone(),
+                    v[3].clone(),
+                    truthful_fifth_row,
+                ];
+                assert!(
+                    kzg_verify_batch::<Bn254, _, _>(
+                        &vk,
+                        &commitments,
+                        w,
+                        &points,
+                        &full,
+                        &mut batch,
+                        &mut NoopVerifierObserver,
+                    ),
+                    "attack {attack}: the five-point opening itself is valid",
+                );
+                let proof = HyperKZGProof {
+                    com,
+                    w,
+                    v,
+                    p0_at_r_fourth,
+                };
+                let rejection = TestScheme::verify(
+                    &vk,
+                    &HyperKZGCommitment::new(commitments[0]),
+                    &point,
+                    &claim,
+                    &proof,
+                    &mut Blake2bTranscript::new(b"review-folds"),
+                );
+                // Which check catches which attack: a tampered non-terminal
+                // fold breaks the derived r^4 row (pairing), a tampered
+                // terminal fold breaks the recomputed claim.
+                let caught_by_chain = attack != 1;
+                assert_eq!(
+                    matches!(rejection, Err(HyperKZGError::PairingCheckFailed)),
+                    caught_by_chain,
+                    "attack {attack} at num_vars={num_vars}: {rejection:?}",
+                );
+                assert_eq!(
+                    matches!(rejection, Err(HyperKZGError::FoldingConsistencyFailed { .. })),
+                    !caught_by_chain,
+                    "attack {attack} at num_vars={num_vars}: {rejection:?}",
+                );
+            }
+        }
+    }
+
+    /// The verifier recomputes the claim from the terminal fold; the even
+    /// terminal (four coefficients, two leftover variables) is the branch the
+    /// existing wrong-claim test does not reach.
+    #[test]
+    fn review_even_terminal_rechecks_claim() {
+        let mut rng = ChaCha20Rng::seed_from_u64(0x5ef6);
+        for num_vars in [2, 4, 6] {
+            let (pk, vk) = test_setup(1 << num_vars);
+            let poly = Polynomial::<Fr>::random(num_vars, &mut rng);
+            let point: Vec<Fr> = (0..num_vars).map(|_| Fr::random(&mut rng)).collect();
+            let claim = poly.evaluate(&point);
+            let (commitment, ()) = TestScheme::commit(poly.evaluations(), &pk).unwrap();
+            let proof = TestScheme::open(
+                &pk,
+                poly.evaluations(),
+                &point,
+                &claim,
+                &mut Blake2bTranscript::new(b"review-claim"),
+            )
+            .unwrap();
+            TestScheme::verify(
+                &vk,
+                &commitment,
+                &point,
+                &claim,
+                &proof,
+                &mut Blake2bTranscript::new(b"review-claim"),
+            )
+            .unwrap();
+            assert!(matches!(
+                TestScheme::verify(
+                    &vk,
+                    &commitment,
+                    &point,
+                    &(claim + Fr::one()),
+                    &proof,
+                    &mut Blake2bTranscript::new(b"review-claim"),
+                ),
+                Err(HyperKZGError::FoldingConsistencyFailed { .. })
+            ));
+        }
+    }
