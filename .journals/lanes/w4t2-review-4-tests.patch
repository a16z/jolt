+/// A per-occurrence link equation is still an equation in `Fr`: adding the
+/// scalar modulus to one occurrence's signed radix-16 integer leaves its link
+/// contribution unchanged. Thus different valid digit strings for the same
+/// scalar remain selectable after `theta`.
+#[test]
+fn digit_link_accepts_a_modulus_shift_in_one_occurrence() {
+    let w = witness(0xE2E);
+    let public = PublicColumns::new(&w.layout);
+    let one_kd = w.check.wires().len() as u32;
+    let occurrence = w
+        .layout
+        .digit_ops
+        .iter()
+        .find(|op| op.kd == one_kd)
+        .expect("constant-one occurrence")
+        .link;
+    let ops: Vec<_> = w
+        .layout
+        .digit_ops
+        .iter()
+        .filter(|op| op.link == occurrence)
+        .collect();
+    assert_eq!(ops.len(), 64);
+
+    let mut value = BigUint::from_bytes_le(&ArkFr::MODULUS.to_bytes_le()) + 1u32;
+    let mut digits = [0i32; 64];
+    for digit in &mut digits {
+        let residue = value.to_u64_digits().first().copied().unwrap_or(0) as i32 & 15;
+        *digit = if residue >= 8 { residue - 16 } else { residue };
+        if *digit < 0 {
+            value += digit.unsigned_abs();
+        } else {
+            value -= *digit as u32;
+        }
+        value >>= 4;
+    }
+    assert!(value.is_zero());
+
+    let mut altered = public.digit_values.clone();
+    for op in ops {
+        altered[op.first_row as usize] = Fr::from_i64(i64::from(digits[63 - op.w as usize]));
+    }
+    assert_ne!(altered, public.digit_values);
+    let rho = Fr::from_u64(19);
+    let omega = omega_column(&w.layout, rho);
+    assert_eq!(
+        LinkMember::new(omega.clone(), &altered).input_claim(),
+        LinkMember::new(omega, &public.digit_values).input_claim(),
+        "one and one plus the scalar modulus are identical to the link"
+    );
+}
+
+#[test]
+fn stream_builder_phase_slices_match_declared_geometry() {
+    use jolt_wrapper::limb_table::stream::commitment_phases;
+
+    let w = witness(0xE2E);
+    let mut rng = ChaCha20Rng::seed_from_u64(0x00C0_1117);
+    let ch = challenges(&mut rng);
+    for packing in [4, 16, 32] {
+        let declared = commitment_phases(packing);
+        let mut builder = StreamBuilder::new(&w.layout, &w.columns, packing);
+        assert_eq!(
+            builder.phase_1b().len() / packing,
+            declared[0].group_count
+        );
+        assert_eq!(
+            builder.phase_2a(ch.xi, ch.alpha).len() / packing,
+            declared[1].group_count
+        );
+        assert_eq!(
+            builder.phase_2b(ch.fp_root).len() / packing,
+            declared[2].group_count
+        );
+        assert_eq!(
+            builder
+                .phase_2c(ch.beta, ch.fp_combine, ch.copy_root)
+                .len()
+                / packing,
+            declared[3].group_count
+        );
+    }
+    assert_eq!(
+        commitment_phases(32).map(|phase| phase.group_count),
+        [3, 3, 1, 2]
+    );
+}
