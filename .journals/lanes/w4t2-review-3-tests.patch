+#[test]
+fn equal_point_exception_is_accepted_by_the_unguarded_add() {
+    let mut program = Program::new(16 * Cells::CONSTANTS.start..16 * Cells::CONSTANTS.end);
+    let point = ark_bn254::G1Affine::generator();
+    let point_rows = vec![program.constant(point.x), program.constant(point.y)];
+    let one = program.one;
+    let add = g1_add(false);
+    let family = Family {
+        name: "equal_add",
+        template: &add,
+        elems: vec![
+            ElemRel::Rows(point_rows.clone()),
+            ElemRel::Rows(point_rows),
+            ElemRel::Rows(vec![one]),
+        ],
+        own_bits: Bits::new(0, 4),
+        own_offset: 0,
+        domain: vec![],
+    };
+    family.emit(&mut program, 0, None);
+    let values = program.evaluate(&[]).expect("evaluate equal-point add");
+    program
+        .check_pins(&values)
+        .expect("the zero slope satisfies the vacuous pin");
+    assert_eq!(values[0], Fq::zero());
+}
