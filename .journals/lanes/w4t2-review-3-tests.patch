+#[test]
+fn digit_link_accepts_different_offset_scalars_per_chain() {
+    use jolt_field::Fr;
+
+    let check = FlattenedCheck::derive(8, 5);
+    let values = random_values(&check, 0xD1617);
+    let setup = random_setup(8, 0xD1618);
+    let layout = build(&check, &values, &setup, &check.wires());
+    let public = PublicColumns::new(&layout);
+    let offset_kd = check.wires().len() as u32 + 1;
+    let mut pair = None;
+    for w in 0..64 {
+        let ops: Vec<_> = layout
+            .digit_ops
+            .iter()
+            .filter(|op| op.kd == offset_kd && op.w == w)
+            .collect();
+        if ops.len() >= 2 {
+            let digit = public.digit_values[ops[0].first_row as usize];
+            if digit != Fr::from_i64(-8) && digit != Fr::from_u64(7) {
+                pair = Some((ops[0], ops[1]));
+                break;
+            }
+        }
+    }
+    let (plus, minus) = pair.expect("an interior offset digit shared by two chains");
+    let rho = Fr::from_u64(19);
+    let omega = omega_column(&layout, rho);
+    let honest = LinkMember::new(omega.clone(), &public.digit_values).input_claim();
+    let mut altered = public.digit_values.clone();
+    altered[plus.first_row as usize] += Fr::from_u64(1);
+    altered[minus.first_row as usize] -= Fr::from_u64(1);
+    let forged = LinkMember::new(omega, &altered).input_claim();
+    assert_eq!(forged, honest, "equal weights cancel the two changes");
+    assert_ne!(
+        altered[plus.first_row as usize], altered[minus.first_row as usize],
+        "the two chains use different offset digits"
+    );
 }
