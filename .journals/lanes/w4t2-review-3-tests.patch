+#[test]
+fn production_dory_links_publish_only_consumed_wires() {
+    let opening = common::synthetic_opening(8, 5, 0xD07);
+    let sigma = opening.witness.sigma();
+    let check = FlattenedCheck::derive(sigma, opening.witness.commitments.len());
+    let mut emitted = check.wires();
+    emitted.extend([DoryScalar::Chi(sigma), DoryScalar::S1Acc, DoryScalar::S2Acc]);
+    let links = DoryLinks {
+        num_vars: 8,
+        sigma,
+        scalars: emitted
+            .into_iter()
+            .enumerate()
+            .map(|(index, scalar)| (scalar, Variable::new(index)))
+            .collect(),
+    };
+    let commitments: Vec<DoryCommitment> = opening
+        .witness
+        .commitments
+        .iter()
+        .map(|value| DoryCommitment(Bn254GT::from(*value)))
+        .collect();
+    let jolt_commitments = JoltCommitments::new(
+        commitments[1].clone(),
+        commitments[0].clone(),
+        commitments[2..].to_vec(),
+        vec![],
+        vec![],
+    );
+    let result = from_jolt(
+        opening.verifier.setup(),
+        &jolt_commitments,
+        &DoryProof(opening.witness.proof),
+        &links,
+        &vec![jolt_field::Fr::from_u64(1); links.scalars.len()],
+        jolt_field::Fr::from_u64(1),
+    );
+    assert_eq!(
+        result.err(),
+        Some(AdapterError::WireSet {
+            links: check.wires().len() + 3,
+            check: check.wires().len(),
+        })
+    );
+}
