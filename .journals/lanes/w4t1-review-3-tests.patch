+#[test]
+fn shifted_noncanonical_word_can_bypass_canonicality() {
+    let shape = (2, 10, 1, 54);
+    let honest = synthetic_log(3, shape.0, shape.1, shape.2, shape.3);
+    let Instance { key, .. } = instance(&honest);
+    let setup = prover_setup(key.rows());
+    let verifier_setup = HyperKZGVerifierSetup::from(&setup);
+
+    let mut canonical = [0u8; 32];
+    canonical[8] = 0x47;
+    canonical[9] = 0xb0;
+    let noncanonical = plus_modulus(canonical, 1);
+    assert_eq!(
+        &noncanonical[..10],
+        &[0x30, 0x64, 0x4e, 0x72, 0xe1, 0x31, 0xa0, 0x2a, 0, 0]
+    );
+    assert_eq!(
+        wire_value(&canonical, true),
+        wire_value(&noncanonical, true)
+    );
+
+    let tampered = synthetic_log_with(
+        3,
+        shape.0,
+        shape.1,
+        shape.2,
+        shape.3,
+        Some(Tamper {
+            round: 0,
+            element: 0,
+            bytes: noncanonical,
+        }),
+    );
+    let Instance { public, table, .. } = instance_under(&tampered, key.clone());
+    let (proof, columns) = prove(&table, &key, &public, &setup);
+    let _ = verify(&proof, &key, &public, &columns, &verifier_setup)
+        .expect("the shifted canonicality constraint reads the wrong half-word");
+}
