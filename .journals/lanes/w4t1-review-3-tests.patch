+#[test]
+fn proof_of_foreign_schedule_verifies_under_key() {
+    let a = instance(&synthetic_log(3, 2, 10, 1, 54));
+    let b = instance(&synthetic_log(3, 3, 10, 1, 54));
+    assert_eq!(a.key.log_rows, b.key.log_rows);
+    assert_eq!(a.public, b.public);
+    assert_ne!(a.key, b.key);
+
+    let setup = prover_setup(a.key.rows());
+    let verifier_setup = HyperKZGVerifierSetup::from(&setup);
+    let (proof, columns) = prove(&b.table, &a.key, &a.public, &setup);
+    let _ = verify(&proof, &a.key, &a.public, &columns, &verifier_setup)
+        .expect("the verifier does not bind schedule-derived columns to the key");
+}
